    "NORTH": ["Delhi", "Haryana", "Punjab", "Rajasthan", "Himachal Pradesh", "Jammu and Kashmir", "Chandigarh", "Uttarakhand"],
    "SOUTH": ["Karnataka", "Tamil Nadu", "Telangana", "Andhra Pradesh", "Kerala", "Puducherry"],
    "WEST": ["Maharashtra", "Gujarat", "Goa"],
    "EAST": ["West Bengal", "Odisha", "Bihar", "Jharkhand"],
    "CENTRAL": ["Madhya Pradesh", "Chhattisgarh", "Uttar Pradesh"],
    "NORTH_EAST": ["Assam", "Meghalaya", "Tripura", "Nagaland", "Manipur", "Mizoram", "Arunachal Pradesh", "Sikkim"]
}

S_DATA = {
    "Karnataka": ("KA", 3, 8, 142, 15.3173, 75.7139),
    "Maharashtra": ("MH", 3, 12, 220, 19.7515, 75.7139),
    "Tamil Nadu": ("TN", 2, 8, 210, 11.1271, 78.6569),
